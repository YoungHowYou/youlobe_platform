# 数据库：留空 = 使用本地 SQLite 文件 <STORAGE_ROOT>/app.db
# 本平台已去除 MySQL。也可以整条写成绝对路径，例如放到 SSD：
#   DATABASE_URL=sqlite:////data/ssd/youlobe/db/app.db
DATABASE_URL=

# 文件存储根目录（原图 / 数据集 / 导出；相对路径相对于项目根目录，也支持绝对路径）
STORAGE_ROOT=./storage

# 训练工作区（raw/preprocessed/cropped/dataset/runs；想用 SSD 就写绝对路径）
#   RUNS_DIR=/data/ssd/youlobe/runs
RUNS_DIR=runs

# 训练结束（completed / cancelled）后把任务目录整体归档到这里
#   ARCHIVE_DIR=/data/hdd/youlobe/archive
ARCHIVE_DIR=archive
TRAIN_AUTO_ARCHIVE=True

# 数据库定期备份到 <ARCHIVE_DIR>/db_backups/
DB_BACKUP_ENABLED=True
DB_BACKUP_INTERVAL_H=6
DB_BACKUP_KEEP=14

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=False

# 前端地址（CORS 白名单，多端口兼容）
CORS_ORIGINS=["http://localhost:5174","http://localhost:5173","http://localhost:80","http://localhost"]

# JWT 密钥（请修改为一个复杂字符串）
JWT_SECRET=your_company_secret_key_change_this_to_something_random
