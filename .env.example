# 数据库：留空 = 使用本地 SQLite 文件 <STORAGE_ROOT>/app.db（默认，无需配置）
# 本平台已去除 MySQL，一般情况下不要填写此项
DATABASE_URL=

# 文件存储根目录（相对路径，相对于项目根目录）
STORAGE_ROOT=./storage

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=False

# 前端地址（CORS 白名单，多端口兼容）
CORS_ORIGINS=["http://localhost:5174","http://localhost:5173","http://localhost:80","http://localhost"]

# JWT 密钥（请修改为一个复杂字符串）
JWT_SECRET=your_company_secret_key_change_this_to_something_random
