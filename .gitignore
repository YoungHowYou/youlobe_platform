# Python
__pycache__/
*.pyc
*.pyo
venv/
*.egg-info/

# Node
node_modules/
web/dist/

# 环境配置（含密码，不提交）
.env

# 数据文件（太大不上传）
storage/uploads/*
storage/datasets/*
storage/runs/*
storage/exports/*
!storage/**/.gitkeep

# 本地 SQLite 库：含真实项目/图片/训练数据，不进版本库
storage/app.db
storage/app.db-shm
storage/app.db-wal
# 存储迁移后留下的一次性副本（确认无误后可删）
storage.old-*/
storage_old_*/
# 由 tools/setup_storage.py 按本机 .env 生成的 systemd drop-in
deploy/systemd/

# 运行时文件
backend.pid

# 训练输出
runs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 备份
backups/

# Claude Code 工作目录
.claude/

# 临时/错误日志
kernel.errors.txt
*.log

# 模型权重（不入库，从 ultralytics 下载即可）
*.pt

# 打包产物
*.zip

# Local admin-private files: private keys, licenses, machine codes
admin_private/

# 本地虚拟环境 / 后端实例锁
.venv/
.backend.pid

